native_format_contact_email":"different.format@hmrc.gov.uk","assets":[{"asset_manager_id":"642ae09bddf8ad0013ac0c7e","filename":"SA108_2023.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":235276,"filename":"SA108_2023.pdf","hoc_paper_number":"","id":"9283854","isbn":"","locale":"en","number_of_pages":4,"title":" Capital gains summary (2023)","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/642ae09bddf8ad0013ac0c7e/SA108_2023.pdf"},{"accessible":false,"alternative_format_contact_email":"different.format@hmrc.gov.uk","assets":[{"asset_manager_id":"65cf59050f4eb10011a9817c","filename":"SA108_Notes_2023.pdf"}],"attachment_type":"file","command_paper_number":"","content_type":"application/pdf","file_size":775142,"filename":"SA108_Notes_2023.pdf","hoc_paper_number":"","id":"9283855","isbn":"","locale":"en","number_of_pages":12,"title":"Capital gains summary notes (2023)","unique_reference":"","unnumbered_command_paper":false,"unnumbered_hoc_paper":false,"url":"https://assets.publishing.service.gov.uk/media/65cf59050f4eb10011a9817c/SA108_Notes_2023.pdf"}],"body":"<div class=\"govspeak\"><p>Use the SA108 supplementary pages when filing your SA100 Tax Return to record capital gains and losses.</p>\n\n<h2 id=\"related-forms-and-guidance\">Related forms and guidance</h2>\n\n<p><a href=\"https://www.gov.uk/government/publications/limit-on-income-tax-reliefs-hs204-self-assessment-helpsheet\">HS204: Limit on Income Tax reliefs</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/entrepreneurs-relief-hs275-self-assessment-helpsheet\">HS275: Business Asset Disposal Relief</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/incorporation-relief-hs276-self-assessment-helpsheet\">HS276: Incorporation Relief</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/temporary-non-residents-and-capital-gains-tax-hs278-self-assessment-helpsheet\">HS278: Temporary Non-residents and Capital Gains Tax</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/husband-and-wife-civil-partners-divorce-dissolution-and-separation-hs281-self-assessment-helpsheet\">HS281: Capital Gains Tax, civil partners and spouses</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/death-personal-representatives-and-legatees-hs282-self-assessment-helpsheet\">HS282: Capital Gains Tax when someone dies</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/private-residence-relief-hs283-self-assessment-helpsheet\">HS283: Private Residence Relief</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/shares-and-capital-gains-tax-hs284-self-assessment-helpsheet\">HS284: Shares and Capital Gains Tax</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/share-reorganisations-company-takeovers-and-capital-gains-tax-hs285-self-assessment-helpsheet\">HS285: Capital Gains Tax, share reorganisations and company takeovers</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/negligible-value-claims-and-income-tax-losses-on-disposals-of-shares-you-have-subscribed-for-in-qualifying-trading-companies-hs286-self-assessment-he\">HS286: Negligible value claims and Income Tax losses on disposal of shares</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/employee-share-and-security-schemes-and-capital-gains-tax-hs287-self-assessment-helpsheet\">HS287: Capital Gains Tax and employee share schemes</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/partnerships-and-capital-gains-tax-hs288-self-assessment-helpsheet\">HS288: Partnerships and Capital Gains Tax</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/business-asset-roll-over-relief-hs290-self-assessment-helpsheet\">HS290: Business asset roll-over relief</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/land-and-leases-the-valuation-of-land-and-capital-gains-tax-hs292-self-assessment-helpsheet\">HS292: Capital Gains Tax land and leases</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/chattels-and-capital-gains-tax-hs293-self-assessment-helpsheet\">HS293: Personal possessions and Capital Gains Tax</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/trusts-and-capital-gains-tax-hs294-self-assessment-helpsheet\">HS294: Trusts and Capital Gains Tax</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/relief-for-gifts-and-similar-transactions-hs295-self-assessment-helpsheet\">HS295: Capital Gains Tax relief on gifts and similar transactions</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/debts-and-capital-gains-tax-hs296-self-assessment-helpsheet\">HS296: Capital Gains Tax and Debts</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/enterprise-investment-scheme-and-capital-gains-tax-hs297-self-assessment-helpsheet\">HS297: Capital Gains Tax and Enterprise Investment Scheme</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/venture-capital-trusts-and-capital-gains-tax-hs298-self-assessment-helpsheet\">HS298: Venture Capital Trusts and Capital Gains Tax</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/non-resident-trusts-and-capital-gains-tax-hs299-self-assessment-helpsheet\">HS299: Non-resident trusts and Capital Gains Tax</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/beneficiaries-receiving-capital-payments-from-non-resident-trusts-and-the-calculation-of-the-increase-in-tax-charge-hs301-self-assessment-helpsheet\">HS301: Beneficiaries receiving capital payments from non-resident trust</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/non-resident-capital-gains-for-land-and-property-in-the-uk-self-assessment-helpsheet-hs307\">HS307: Non-resident Capital Gains for land and property in the UK</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/investors-relief-2020-hs308\">HS308: Investors’ Relief</a></p>\n\n<p><a href=\"https://www.gov.uk/government/publications/seed-enterprise-investment-scheme-income-tax-and-capital-gains-tax-reliefs-hs393-self-assessment-helpsheet\">HS393: Seed Enterprise Investment Scheme - Income Tax and Capital Gains Tax reliefs</a></p>\n\n</div>","change_history":[{"note":"The English and Welsh form notes for tax year 2025 to 2026 have been updated. ","public_timestamp":"2026-05-13T11:00:30Z"},{"note":"The form and notes have been added for tax year 2025 to 2026. The versions for tax year 2021 to 2022 have been removed.","public_timestamp":"2026-04-05T23:15:20Z"},{"note":"The form and notes have been added for tax year 2024 to 2025. The versions for tax year 2020 to 2021 have been removed.","public_timestamp":"2025-04-05T23:15:16Z"},{"note":"The form and notes have been added for tax year 2023 to 2024, and the versions for tax year 2019 to 2020 have been removed.","public_timestamp":"2024-04-05T23:01:02Z"},{"note":"The capital gains summary notes 2023 have been updated. ","public_timestamp":"2024-02-19T11:56:55Z"},{"note":"The form and notes have been added for tax year 2022 to 2023, and the versions for tax year 2018 to 2019 have been removed.","public_timestamp":"2023-04-05T23:15:22Z"},{"note":"The form and notes have been added for tax year 2021 to 2022, and the versions for tax year 2017 to 2018 have been removed.","public_timestamp":"2022-04-05T23:15:15Z"},{"note":"The Capital gains summary notes (2021) have been updated. ","public_timestamp":"2021-07-19T12:59:09Z"},{"note":"The Capital gains summary form and notes have been added for tax year 2020 to 2021.","public_timestamp":"2021-04-05T23:15:28Z"},{"note":"Helpsheets HS307 Non-resident Capital Gains for land and property in the UK and HS308 Investors' Relief have been added.","public_timestamp":"2020-05-22T10:37:55Z"},{"note":"The Capital gains summary form and notes have been added for tax year 2019 to 20